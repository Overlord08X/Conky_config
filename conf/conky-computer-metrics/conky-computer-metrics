-- Systems metrics - ThinkPad T490s / Arch Linux
-- Fixes: lsb_release → /etc/os-release, locale → /etc/locale.conf,
--        wlp164s0 → wlp0s20f3, fan removed (not exposed), sensors fixed

conky.config = {
    background = false,
    font = 'FiraCode Nerd Font:pixelsize=12',
    use_xft = true,
    xftalpha = 1.0,
    update_interval = 4,
    total_run_times = 0,
    own_window = true,
    own_window_transparent = true,
    own_window_type = 'desktop',
    own_window_class = 'Conky',
    own_window_argb_visual = true,
    own_window_argb_value = 0,
    own_window_colour = '#00000000',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    double_buffer = true,
    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = true,
    stippled_borders = 0,
    border_width = 0,
    default_color = '#BEC8CB',
    default_shade_color = '#BEC8CB',
    default_outline_color = '#BEC8CB',
    alignment = 'top_left',
    gap_x = 1260,
    gap_y = 70,
    no_buffers = true,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    use_spacer = 'none',
    maximum_width = 1024,
    minimum_height = 640,
    uppercase = true,
};

conky.text = [[
#leet chars: ┤┤└└┴┴┐┐││┘┘┌┌├├┬┬┼┼┴┴── ││ ▽▼△▲▵▴▾▿
${alignr}${offset 250}--------------------------------
${alignr}${offset 0}┌──────── ${nodename}${font} ─────────────
${alignr}${offset -217}${uid_name 1000}${font} ──────┤
${alignr}${offset -217}< ${execi 3600 lsb_release -ds | sed 's/"//g'} > Distro ─┤
${alignr}${offset -217}< ${kernel} > Kernel ─┤
${alignr}${offset -217}< ${uptime_short} > Uptime ─┘
${voffset 0}
${alignr}${offset -30}┌──────────
${alignr}${offset -100}│
${alignr}${offset -100}< ${execi 3600 lspci | grep VGA | sed 's/.*\[//' | sed 's/\].*//'} > GPU ────────────┘
${alignr}${offset -198}< ${execi 3600 xdpyinfo | awk '/dimensions/{print $2}'} > Res
${voffset 10}
${alignr}${offset -80}< ${execi 3600 locale | grep LANG= | cut -d= -f2} > Locale ────────────────┐
${alignr}${offset -80}│
${alignr}${offset -38}└─────┐
${voffset -14}
${alignr}${offset -68}< ${execi 5 sensors 2>/dev/null | awk '/fan1/ {print $2 " RPM"}'} > Fan Speed ──────────┐${offset 30}│
${alignr}${offset -68}│${offset 30}│
${alignr}${offset -68}│${offset 30}│
${alignr}${offset -75}│
${alignr}${offset -75}┌───── Temperatures ───────────────┤
${alignr}${offset -180}├─ Core0 < ${execi 5 sensors 2>/dev/null | awk '/Core 0/ {print $3}'} >${alignr}${offset -75}│
${alignr}${offset -180}├─ Core1 < ${execi 5 sensors 2>/dev/null | awk '/Core 1/ {print $3}'} >${alignr}${offset -75}│
${alignr}${offset -180}├─ Core2 < ${execi 5 sensors 2>/dev/null | awk '/Core 2/ {print $3}'} >${alignr}${offset -75}│
${alignr}${offset -180}└─ Core3 < ${execi 5 sensors 2>/dev/null | awk '/Core 3/ {print $3}'} >${alignr}${offset -75}│
${alignr}${offset -75}│
${alignr}${offset -75}│
${alignr}${offset -75}┌─── < ${execi 3600 lscpu | awk -F: '/Model name/ {print $2}' | sed 's/^ *//'} > ───┤
${alignr}${offset -439}│${offset 364}│
${alignr}${offset -306}└──────── Processes ${offset 231}│
${alignr}${offset -194}< ${top name 1}  ${top cpu 1} >${offset 119}│
${alignr}${offset -194}< ${top name 2}  ${top cpu 2} >${offset 119}│
${alignr}${offset -194}< ${top name 3}  ${top cpu 3} >${offset 119}│
${alignr}${offset -194}< ${top name 4}  ${top cpu 4} >${offset 119}│
${alignr}${offset -75}│
${voffset 15}
${alignr}${offset -75}< $memperc% | $mem/$memmax ${color #BEC8CB}${membar 5,50}${color} > RAM ──────────┐
${alignr}${offset -75}│
${voffset 0}
${alignr}${offset -75}${addr wlp0s20f3} : ${wireless_essid wlp0s20f3} : SSID ────────────┐
${alignr}${offset -166}${voffset 2}UP < ${color #BEC8CB}${upspeedgraph wlp0s20f3 15,130 BCC3C3 BCC3C3}${color} >${voffset -0}${offset 91}│
${alignr}${offset -159}${voffset 2}DOWN < ${color #BEC8CB}${downspeedgraph wlp0s20f3 15,130 BCC3C3 BCC3C3}${color} >${voffset -8}${offset 91}└─
${voffset 20}
${alignr}${offset -75}${battery_percent BAT0} : Battery ───────────────────┐
${alignr}${offset -95}< ${exec acpi | grep "Battery 0" | awk '{print $4}'} | ${battery_percent BAT0}% > BAT 0 < ${color #BEC8CB}${battery_bar 5,110 BAT0}${color} >${offset 20}│
${alignr}${offset -75}│
${voffset 30}
${alignr}${offset -85}Hard Drive ─────────────────┐
${alignr}${offset -95}< ${fs_used_perc}% > Root < ${color #BEC8CB}${fs_bar 5,120 /}${color} >${offset 10}│
${alignr}${offset -95}< ${fs_used_perc /home}% > Home < ${color #BEC8CB}${fs_bar 5,120 /home}${color} >${offset 10}│
${alignr}${offset -11}< ${swapperc}% > Swap < ${color #BEC8CB}${swapbar 5,120}${color} >${offset 10}└────────────
${voffset 0}
${alignr}${offset -60}volume: ${exec wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100)"%"}'}
]];
